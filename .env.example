# ==============================================================================
# EVENTPRO BACKEND - ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env.example)
# Copia este archivo a '.env' y completa con tus valores reales de desarrollo.
# ==============================================================================

# --- APLICACIÓN Y SERVIDOR ---
APP_ENV=development
APP_NAME=EventPro-Backend
API_V1_PREFIX=/api/v1
PORT=8000
DEBUG=true
SECRET_KEY=supersecretkey_change_in_production_min_32_chars_long!
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.eventpro.pe

# --- BASE DE DATOS (POSTGRESQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eventpro_user
POSTGRES_PASSWORD=eventpro_secret_password
POSTGRES_DB=eventpro_db
DATABASE_URL=postgresql+asyncpg://eventpro_user:eventpro_secret_password@localhost:5432/eventpro_db

# --- CACHÉ Y LOCKS CONCURRENTES (REDIS) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- META / WHATSAPP BUSINESS CLOUD API ---
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAG...tu_token_permanente_de_meta...
WHATSAPP_VERIFY_TOKEN=token_secreto_webhook_eventpro_2026

# --- GOOGLE MAPS PLATFORM ---
GOOGLE_MAPS_API_KEY=AIzaSy...tu_clave_de_google_maps_platform...
# Coordenadas de la base de operaciones de la promotora en Lima
PROMOTORA_BASE_LATITUDE=-12.0864
PROMOTORA_BASE_LONGITUDE=-77.0328

# --- PARÁMETROS CONFIGURABLES DE REGLAS DE NEGOCIO ---
# Umbral de shows simultáneos (solapamiento real de intervalos) que dispara la aprobación manual del encargado
SIMULTANEOUS_SHOWS_THRESHOLD=3
# Horas de vigencia para pagar el adelanto desde el envío de la cotización (vencida: EXPIRED)
ADVANCE_DEADLINE_HOURS=24
# Minutos tras los cuales el bot revalida disponibilidad antes de mostrar los datos de pago
AVAILABILITY_RECHECK_MINUTES=60
# Margen comercial porcentual sobre el costo de movilidad
MOBILITY_MARGIN_PERCENT=15
# Porcentaje de adelanto obligatorio sobre servicios contratados (sin movilidad)
ADVANCE_PERCENT=10
# Margen mínimo de descanso y desarme entre shows sucesivos del mismo elenco (minutos)
TRANSIT_REST_BUFFER_MINUTES=30

# --- REPOSITORIO DE ARCHIVOS Y PDFS ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads

# --- ARRANQUE DEL USUARIO SUPERADMIN (solo para el comando de bootstrap; retirar tras el primer arranque) ---
SUPERADMIN_EMAIL=admin@eventpro.pe
SUPERADMIN_PASSWORD=admin123

# --- Aplicación y servidor ---
APP_ENV=development
APP_NAME=EventPro-Backend
API_V1_PREFIX=/api/v1
PORT=8000
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000

# --- Chatwoot (gateway de mensajeria; las credenciales de Meta viven dentro de Chatwoot) ---
CHATWOOT_BASE_URL=http://chatwoot-rails:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_BOT_TOKEN=change-me
CHATWOOT_AGENT_TOKEN=change-me
CHATWOOT_WEBHOOK_SECRET=change-me

# --- Proxy (solo servidor; docker-compose.proxy.yml) ---
EVENTPRO_DOMAIN=eventpro-demo.duckdns.org
# FRONTEND_UPSTREAM=frontend:3000
# CHATWOOT_LOCAL_PORT=3001

# --- Reglas de negocio ---
ADVANCE_PERCENT=10

# --- Firma electrónica (ADR-07) ---
# Certificado PKCS#12 de desarrollo en ./secrets/ (no versionado)
SIGNATURE_PKCS12_PATH=./secrets/eventpro-signing.p12
SIGNATURE_PKCS12_PASSWORD=change-me-dev
# TSA RFC 3161 opcional; vacío desactiva la marca de tiempo
SIGNATURE_TSA_URL=
SIGNATURE_LINK_TTL_HOURS=168
SIGNATURE_OTP_TTL_MINUTES=10
SIGNATURE_OTP_MAX_ATTEMPTS=5
SIGNATURE_OTP_PROOF_TTL_MINUTES=15

# --- Instrucciones de pago mostradas por el bot ---
PAYMENT_YAPE_NUMBER=900000000
PAYMENT_PLIN_NUMBER=900000000
PAYMENT_BANK_NAME=Banco de ejemplo
PAYMENT_BANK_ACCOUNT=000-00000000-0-00
PAYMENT_BANK_CCI=00000000000000000000
PAYMENT_ACCOUNT_HOLDER=Nombre del titular