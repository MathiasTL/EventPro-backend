# Variables de Chatwoot (docker-compose.chatwoot.yml). Copiar a `chatwoot.env` (no versionado).
# Solo placeholders: nunca guardar secretos reales en este archivo.
# Referencia oficial: https://github.com/chatwoot/chatwoot/blob/develop/.env.example

# --- Aplicacion -------------------------------------------------------------
# Generar con: openssl rand -hex 64
SECRET_KEY_BASE=change-me-generate-with-openssl-rand-hex-64
# URL con la que se accede a Chatwoot desde fuera (la usan Meta y los enlaces de medios).
# Local con ngrok: https://<dominio-estatico>.ngrok-free.app
# Servidor: https://chat.<EVENTPRO_DOMAIN>
FRONTEND_URL=http://localhost:3001
RAILS_ENV=production
INSTALLATION_ENV=docker
# Debe permanecer en false, tambien en servidor y con tunel. Con true, Rails responde 301 a HTTPS a toda
# peticion HTTP, y el backend llama a http://chatwoot-rails:3000 dentro de Docker sin seguir redirecciones.
# El trafico publico sigue siendo HTTPS: Caddy (o ngrok) termina TLS y Rails nunca se expone directamente.
FORCE_SSL=false
# Sin registro publico: la cuenta se crea una sola vez por consola (ver guia de Docker).
ENABLE_ACCOUNT_SIGNUP=false
RAILS_MAX_THREADS=5

# --- Webhooks hacia EventPro (OBLIGATORIO) ----------------------------------
# Chatwoot 4.18 envia los webhooks de cuenta con SafeFetch/ssrf_filter, que descarta toda URL cuyo
# host resuelva a una IP no publica. Sin esta variable, el webhook interno
# http://api:8000/api/v1/webhooks/chatwoot nunca llega a EventPro.
# Contrapartida: desactiva la proteccion SSRF para todas las peticiones de SafeFetch; es aceptable
# porque el panel de administracion no es publico.
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true

# --- Claves de cifrado (MFA/2FA) --------------------------------------------
# Opcionales; generar con: docker compose ... run --rm chatwoot-rails bundle exec rails db:encryption:init
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- PostgreSQL (contenedor chatwoot-db) ------------------------------------
# POSTGRES_HOST/USERNAME/PASSWORD los lee Chatwoot; POSTGRES_USER/DB los lee la imagen de PostgreSQL.
POSTGRES_HOST=chatwoot-db
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chatwoot_production
POSTGRES_DATABASE=chatwoot_production

# --- Redis (contenedor chatwoot-redis) ---------------------------------------
REDIS_URL=redis://chatwoot-redis:6379
REDIS_PASSWORD=change-me

# --- Almacenamiento ----------------------------------------------------------
# Disco local (volumen chatwoot_storage). Medios entrantes y adjuntos.
ACTIVE_STORAGE_SERVICE=local
VIPS_BLOCK_UNTRUSTED=1

# --- Registros ---------------------------------------------------------------
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
LOG_SIZE=500

# --- Correo saliente (opcional) ----------------------------------------------
# Sin SMTP, Chatwoot no envia correos (invitaciones, recuperacion). No es necesario para la demo.
# MAILER_SENDER_EMAIL=EventPro <no-reply@example.com>
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
